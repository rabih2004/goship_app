// Shipping Platform — Prisma schema (MySQL 5.7+).
// VARCHAR lengths are capped to keep all indexes under MySQL 5.7's
// 1000-byte InnoDB key prefix limit when running with COMPACT row format.
// Tables prefixed with `Auth*` are required by @auth/prisma-adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Auth.js v5 (NextAuth) — required tables
// =====================================================================

model User {
  id            String    @id @default(cuid()) @db.VarChar(30)
  email         String    @unique               @db.VarChar(160)
  emailVerified DateTime?
  name          String?                          @db.VarChar(120)
  passwordHash  String?                          @db.VarChar(120)
  role          UserRole  @default(CUSTOMER)
  locale        String    @default("en")         @db.VarChar(10)
  // Display currency for money on user-facing pages. Settlement stays in USD
  // (Stripe / Connect). ISO 4217, validated against the FxRate table.
  preferredCurrency String @default("USD")       @db.VarChar(3)
  phone         String?                          @db.VarChar(30)
  suspended     Boolean   @default(false)
  image         String?                          @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  forwarderProfile    ForwarderProfile?
  coworkerProfile     CoworkerProfile?
  customsAgentProfile CustomsAgentProfile?
  shipments           Shipment[]            @relation("CustomerShipments")
  quotes              Quote[]               @relation("ForwarderQuotes")
  coworkerQuotes      CoworkerQuote[]       @relation("CoworkerQuotes")
  customsQuotes       CustomsQuote[]        @relation("CustomsQuotes")
  bookingsAsCust      Booking[]             @relation("CustomerBookings")
  bookingsAsFwd       Booking[]             @relation("ForwarderBookings")
  bookingsAsCowo      Booking[]             @relation("CoworkerBookings")
  bookingsAsCustoms   Booking[]             @relation("CustomsBookings")
  reviewsAuthored     Review[]              @relation("ReviewsAuthored")
  reviewsReceived     Review[]              @relation("ReviewsReceived")
  messagesAuthored    Message[]             @relation("MessagesAuthored")
  conversationReads   ConversationRead[]
  trackingEvents      TrackingEvent[]
  uploadedDocuments   Document[]
  subscriptions            Subscription[]
  notifications            Notification[]
  preferredPickupShipments Shipment[]     @relation("PreferredCoworker")

  @@map("user")
}

model Account {
  id                String  @id @default(cuid())  @db.VarChar(30)
  userId            String                          @db.VarChar(30)
  type              String                          @db.VarChar(30)
  provider          String                          @db.VarChar(60)
  providerAccountId String                          @db.VarChar(120)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?                         @db.VarChar(30)
  scope             String?                         @db.VarChar(200)
  id_token          String? @db.Text
  session_state     String?                         @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())  @db.VarChar(30)
  sessionToken String   @unique                @db.VarChar(200)
  userId       String                          @db.VarChar(30)
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String   @db.VarChar(100)
  token      String   @unique @db.VarChar(100)
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// =====================================================================
// Domain models
// =====================================================================

model ForwarderProfile {
  userId             String   @id                              @db.VarChar(30)
  companyName        String                                    @db.VarChar(120)
  registrationNumber String?                                   @db.VarChar(80)
  countryCode        String                                    @db.VarChar(2)
  logoUrl            String?                                   @db.VarChar(500)
  stripeAccountId    String?  @unique                          @db.VarChar(80)
  onboardingComplete Boolean  @default(false)
  ratingAvg          Float    @default(0)
  ratingCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lanes Lane[]

  @@map("forwarder_profile")
}

model CustomsAgentProfile {
  userId             String   @id                       @db.VarChar(30)
  displayName        String                              @db.VarChar(120)  // firm or individual
  countryCode        String                              @db.VarChar(2)   // operating country (matches destinationPort.country)
  operationCities    String?                             @db.Text          // optional comma-separated list of city names
  licenseNumber      String?                             @db.VarChar(80)   // broker license, if any
  logoUrl            String?                             @db.VarChar(500)
  baseFeeUSDCents    Int      @default(15000)                              // $150 default base
  docSetFeeUSDCents  Int      @default(5000)                               // $50 per document set
  stripeAccountId    String?  @unique                   @db.VarChar(80)
  onboardingComplete Boolean  @default(false)
  ratingAvg          Float    @default(0)
  ratingCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode])
  @@map("customs_agent_profile")
}

model CoworkerProfile {
  userId                  String   @id                       @db.VarChar(30)
  displayName             String                              @db.VarChar(120)  // company or individual
  countryCode             String                              @db.VarChar(2)
  cityArea                String                              @db.VarChar(120)  // free-form, e.g. "Beirut, Lebanon"
  serviceCenterLat        Float?
  serviceCenterLng        Float?
  serviceRadiusKm         Int      @default(50)
  perKmRateUSDCents       Int      @default(100)                                 // $1.00 / km
  baseFeeUSDCents         Int      @default(2000)                                // $20.00 minimum
  vehicleType             String   @default("Van")            @db.VarChar(40)    // Van | Truck-20ft | Truck-40ft | Flatbed
  vehicleCapacityKg       Int      @default(1000)
  logoUrl                 String?                              @db.VarChar(500)
  stripeAccountId         String?  @unique                   @db.VarChar(80)
  onboardingComplete      Boolean  @default(false)
  ratingAvg               Float    @default(0)
  ratingCount             Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode])
  @@map("coworker_profile")
}

model Lane {
  id                      String   @id @default(cuid())  @db.VarChar(30)
  forwarderId             String                           @db.VarChar(30)
  originPortUnlocode      String                           @db.VarChar(10)
  destinationPortUnlocode String                           @db.VarChar(10)
  transitDays             Int
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())

  forwarder       ForwarderProfile @relation(fields: [forwarderId], references: [userId], onDelete: Cascade)
  originPort      Port             @relation("LaneOrigin", fields: [originPortUnlocode], references: [unlocode])
  destinationPort Port             @relation("LaneDestination", fields: [destinationPortUnlocode], references: [unlocode])

  @@unique([forwarderId, originPortUnlocode, destinationPortUnlocode])
  @@index([originPortUnlocode, destinationPortUnlocode])
  @@map("lane")
}

model Port {
  unlocode String  @id @db.VarChar(10) // e.g. "LBBEY", "DEHAM"
  name     String  @db.VarChar(120)
  country  String  @db.VarChar(2)      // ISO-3166 alpha-2
  lat      Float?
  lng      Float?

  lanesAsOrigin          Lane[]     @relation("LaneOrigin")
  lanesAsDestination     Lane[]     @relation("LaneDestination")
  shipmentsAsOrigin      Shipment[] @relation("ShipOrigin")
  shipmentsAsDestination Shipment[] @relation("ShipDestination")

  @@index([country])
  @@index([name])
  @@map("port")
}

model Shipment {
  id                      String          @id @default(cuid()) @db.VarChar(30)
  customerId              String                                @db.VarChar(30)
  originPortUnlocode      String                                @db.VarChar(10)
  destinationPortUnlocode String                                @db.VarChar(10)
  containerType           ContainerType
  cargoDescription        String                                @db.Text
  weightKg                Int
  readyDate               DateTime
  incoterm                Incoterm        @default(FOB)
  status                  ShipmentStatus  @default(RFQ_OPEN)
  // Customer wants customs clearance handled by an agent at destination.
  needsCustomsClearance   Boolean         @default(false)
  // Optional cargo-insurance opt-in. Declared at RFQ time, priced at booking.
  wantsInsurance          Boolean         @default(false)
  cargoValueUSDCents      Int?
  // ExWorks-only: pickup factory + contact (nullable, populated when incoterm = EXW)
  factoryAddressLine      String?                               @db.VarChar(300)
  factoryCity             String?                               @db.VarChar(120)
  factoryLat              Float?
  factoryLng              Float?
  pickupContactName       String?                               @db.VarChar(120)
  pickupContactPhone      String?                               @db.VarChar(40)
  // Customer's preferred coworker for the pickup leg (EXW only). Cleared after decline.
  preferredCoworkerId     String?                               @db.VarChar(30)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  customer           User      @relation("CustomerShipments", fields: [customerId], references: [id])
  originPort         Port      @relation("ShipOrigin", fields: [originPortUnlocode], references: [unlocode])
  destinationPort    Port      @relation("ShipDestination", fields: [destinationPortUnlocode], references: [unlocode])
  preferredCoworker  User?     @relation("PreferredCoworker", fields: [preferredCoworkerId], references: [id])
  quotes             Quote[]
  coworkerQuotes     CoworkerQuote[]
  customsQuotes      CustomsQuote[]
  booking            Booking?

  @@index([status])
  @@index([originPortUnlocode, destinationPortUnlocode])
  @@index([customerId])
  @@map("shipment")
}

model CustomsQuote {
  id              String      @id @default(cuid()) @db.VarChar(30)
  shipmentId      String                            @db.VarChar(30)
  customsAgentId  String                            @db.VarChar(30)
  priceUSDCents   Int
  etaDays         Int                                                  // days to clear customs after vessel arrival
  notes           String?                           @db.Text
  validUntil      DateTime
  status          QuoteStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customsAgent User     @relation("CustomsQuotes", fields: [customsAgentId], references: [id])
  booking      Booking?

  @@unique([shipmentId, customsAgentId])
  @@index([status])
  @@map("customs_quote")
}

model CoworkerQuote {
  id              String      @id @default(cuid()) @db.VarChar(30)
  shipmentId      String                            @db.VarChar(30)
  coworkerId      String                            @db.VarChar(30)
  distanceKm      Float
  priceUSDCents   Int
  pickupTime      DateTime?
  vehicleNote     String?                           @db.VarChar(120)
  notes           String?                           @db.Text
  validUntil      DateTime
  status          QuoteStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  coworker User     @relation("CoworkerQuotes", fields: [coworkerId], references: [id])
  booking  Booking?

  @@unique([shipmentId, coworkerId])
  @@index([status])
  @@map("coworker_quote")
}

model Quote {
  id            String      @id @default(cuid()) @db.VarChar(30)
  shipmentId    String                            @db.VarChar(30)
  forwarderId   String                            @db.VarChar(30)
  priceUSDCents Int
  transitDays   Int
  carrierName   String                            @db.VarChar(80)
  validUntil    DateTime
  status        QuoteStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  forwarder User     @relation("ForwarderQuotes", fields: [forwarderId], references: [id])
  booking   Booking?

  @@unique([shipmentId, forwarderId])
  @@index([status])
  @@map("quote")
}

model Booking {
  id                    String   @id @default(cuid())  @db.VarChar(30)
  shipmentId            String   @unique                @db.VarChar(30)
  quoteId               String   @unique                @db.VarChar(30)
  customerId            String                          @db.VarChar(30)
  forwarderId           String                          @db.VarChar(30)
  // Optional pickup leg (ExWorks). Null for FOB bookings.
  pickupQuoteId         String?  @unique                @db.VarChar(30)
  coworkerId            String?                         @db.VarChar(30)
  pickupAmountUSDCents  Int      @default(0)
  // Optional customs leg. Null when the customer didn't request customs.
  customsQuoteId        String?  @unique                @db.VarChar(30)
  customsAgentId        String?                         @db.VarChar(30)
  customsAmountUSDCents Int      @default(0)
  // Cargo insurance — snapshot at booking time. Null/zero = no insurance.
  insuranceUSDCents     Int      @default(0)
  cargoValueUSDCents    Int?
  bookingNumber         String   @unique                @db.VarChar(40)
  stripePaymentIntentId String?  @unique                @db.VarChar(80)
  stripeCheckoutId      String?  @unique                @db.VarChar(80)
  totalUSDCents         Int
  platformFeeUSDCents   Int
  paidAt                DateTime?
  createdAt             DateTime @default(now())

  shipment       Shipment        @relation(fields: [shipmentId], references: [id])
  quote          Quote           @relation(fields: [quoteId], references: [id])
  pickupQuote    CoworkerQuote?  @relation(fields: [pickupQuoteId], references: [id])
  customsQuote   CustomsQuote?   @relation(fields: [customsQuoteId], references: [id])
  customer       User            @relation("CustomerBookings", fields: [customerId], references: [id])
  forwarder      User            @relation("ForwarderBookings", fields: [forwarderId], references: [id])
  coworker       User?           @relation("CoworkerBookings", fields: [coworkerId], references: [id])
  customsAgent   User?           @relation("CustomsBookings", fields: [customsAgentId], references: [id])
  trackingEvents TrackingEvent[]
  documents      Document[]
  reviews        Review[]
  conversation   Conversation?
  disputes       Dispute[]

  @@map("booking")
}

// Customer/forwarder-raised dispute on a booking. Out-of-band resolution by
// admin in v1 — no escrow, no automated refunds. Admin marks RESOLVED with a
// short note that both parties can read on their booking detail page.
model Dispute {
  id            String         @id @default(cuid()) @db.VarChar(30)
  bookingId     String                                @db.VarChar(30)
  openedByUserId String                               @db.VarChar(30)
  reason        DisputeReason
  description   String                                @db.Text
  status        DisputeStatus @default(OPEN)
  adminNote     String?                               @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("dispute")
}

// One conversation per booking. All booking parties (customer + forwarder
// + coworker? + customs agent?) are implicit participants — we don't store
// a join table; we just compare senders to the booking's user IDs.
model Conversation {
  id            String    @id @default(cuid()) @db.VarChar(30)
  bookingId     String    @unique                @db.VarChar(30)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  booking  Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages Message[]
  reads    ConversationRead[]

  @@map("conversation")
}

model Message {
  id             String   @id @default(cuid()) @db.VarChar(30)
  conversationId String                          @db.VarChar(30)
  senderId       String                          @db.VarChar(30)
  body           String                          @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessagesAuthored", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("message")
}

// Per-user "last read at" pointer. Unread count = messages newer than this.
model ConversationRead {
  conversationId String   @db.VarChar(30)
  userId         String   @db.VarChar(30)
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_read")
}

model Review {
  id          String   @id @default(cuid()) @db.VarChar(30)
  bookingId   String                          @db.VarChar(30)
  raterUserId String                          @db.VarChar(30)
  ratedUserId String                          @db.VarChar(30)
  ratedRole   UserRole
  score       Int                              // 1..5
  comment     String?                          @db.Text
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rater   User    @relation("ReviewsAuthored", fields: [raterUserId], references: [id])
  rated   User    @relation("ReviewsReceived", fields: [ratedUserId], references: [id])

  // One review per (booking, rater→rated) pair — enforces "no double-reviewing".
  @@unique([bookingId, raterUserId, ratedUserId])
  @@index([ratedUserId])
  @@map("review")
}

model TrackingEvent {
  id          String         @id @default(cuid()) @db.VarChar(30)
  bookingId   String                                @db.VarChar(30)
  stage       TrackingStage
  occurredAt  DateTime       @default(now())
  notes       String?        @db.Text
  createdById String                                @db.VarChar(30)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([bookingId, occurredAt])
  @@map("tracking_event")
}

model Document {
  id           String       @id @default(cuid()) @db.VarChar(30)
  bookingId    String                              @db.VarChar(30)
  type         DocumentType
  storageKey   String                              @db.VarChar(300)
  filename     String                              @db.VarChar(200)
  contentType  String                              @db.VarChar(80)
  sizeBytes    Int
  uploadedById String                              @db.VarChar(30)
  uploadedAt   DateTime     @default(now())

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([bookingId])
  @@map("document")
}

// In-app notifications. One row per (user, event) — fan-out at write time
// rather than fan-in at read time so the inbox query stays a single index hit.
//
// `type` provides the verb (template); `bodyText` carries proper nouns
// ("Booking GS-2026-0042 advanced to Loaded"). `linkPath` is locale-less —
// the bell prepends the current locale at render time.
model Notification {
  id         String           @id @default(cuid()) @db.VarChar(30)
  userId     String                                @db.VarChar(30)
  type       NotificationType
  bookingId  String?                               @db.VarChar(30)
  shipmentId String?                               @db.VarChar(30)
  bodyText   String?                               @db.VarChar(280)
  linkPath   String?                               @db.VarChar(300)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hot path: "unread count for this user" + "recent for this user".
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

// Recurring monthly subscriptions for Coworker + Customs Agent roles.
// Forwarders are not gated by this — they pay platform commission per booking
// via Stripe Connect. Customers don't pay platform fees, only shipments.
model Subscription {
  id                     String             @id @default(cuid()) @db.VarChar(30)
  userId                 String                                  @db.VarChar(30)
  // Snapshot of the role at sub-time; lets us scope tier validation cleanly.
  role                   UserRole
  tierName               String                                  @db.VarChar(40)  // "Basic" / "Pro" later
  priceUSDCents          Int
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  status                 SubscriptionStatus @default(ACTIVE)
  provider               String             @default("mock")     @db.VarChar(20)  // "mock" | "stripe"
  providerSubscriptionId String?                                 @db.VarChar(120)
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Look up "the current active sub for this user" — common path.
  @@index([userId, status])
  @@map("subscription")
}

model FxRate {
  date     DateTime
  currency String   @db.VarChar(3) // ISO 4217
  usdRate  Float    // 1 unit of currency = usdRate USD

  @@id([date, currency])
  @@map("fx_rate")
}

// =====================================================================
// Enums
// =====================================================================

enum UserRole {
  CUSTOMER
  FORWARDER
  COWORKER
  CUSTOMS_AGENT
  ADMIN
}

enum ContainerType {
  TWENTY_FT
  FORTY_FT
  FORTY_HC
  LCL
}

enum Incoterm {
  FOB
  EXW
  // CIF, DAP, DDP reserved for future iterations
}

enum ShipmentStatus {
  DRAFT
  RFQ_OPEN
  BOOKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum TrackingStage {
  BOOKED
  LOADED
  DEPARTED
  ARRIVED
  CLEARED
  DELIVERED
}

enum DocumentType {
  BL
  INVOICE
  PACKING_LIST
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum DisputeReason {
  DAMAGED_CARGO
  LATE_DELIVERY
  WRONG_CARGO
  DOCUMENTATION
  BILLING
  OTHER
}

enum NotificationType {
  NEW_RFQ_ON_LANE
  NEW_QUOTE_RECEIVED
  QUOTE_ACCEPTED
  BOOKING_STAGE_ADVANCED
  DOCUMENT_UPLOADED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  REVIEW_RECEIVED
  PICKUP_REQUEST
  PICKUP_REQUEST_BROADCAST
}

# Copy to .env and fill in real values. Do not commit .env.

# Brand identity — drives every header/footer/title rendering of the brand name.
NEXT_PUBLIC_BRAND_NAME="GoShip"

DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DBNAME"

AUTH_SECRET="generate via: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Payments — "mock" for dev/demo, "stripe" for production
PAYMENT_PROVIDER="mock"
PLATFORM_COMMISSION_PERCENT="7"

# Stripe — required only when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Maps & geocoding — "osm" for dev (free), "mapbox" stub for later
MAP_PROVIDER="osm"

# Storage — "mock" for dev (local fs), "s3" for prod (R2 / S3)
STORAGE_PROVIDER="mock"
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="goship-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# If your bucket has a public custom domain (e.g. Cloudflare R2 custom domain),
# set this to serve avatars/documents without presigned URLs.
# S3_PUBLIC_URL="https://your-custom-domain.com"

# Carrier pricing — "mock" for deterministic baselines, "cmacgm" / "freighty" stubs
CARRIER_PRICING_PROVIDER="mock"

# Vessel tracking — "mock" interpolates along great-circle, "marinetraffic" / "ais" stubs
VESSEL_TRACKING_PROVIDER="mock"

# Subscriptions (Coworker + Customs Agent monthly membership)
# "mock" = one-click activate, 30-day period, no real charge
# "stripe" = Stripe Billing (stub, not wired)
SUBSCRIPTION_PROVIDER="mock"

# Cargo insurance rate in basis points. 150 bps = 1.5% (default).
INSURANCE_RATE_BPS="150"

# Shared secret for the daily FX-rate cron at /api/cron/fx-rates.
# Vercel cron header `Authorization: Bearer $CRON_SECRET` matches this.
CRON_SECRET="generate via: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# Email — "mock" for dev (server log), "resend" for prod
EMAIL_PROVIDER="mock"
EMAIL_FROM="GoShip <onboarding@resend.dev>"
EMAIL_REPLY_TO=""
RESEND_API_KEY="re_..."
